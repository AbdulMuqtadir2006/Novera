# ---- database (Railway Postgres plugin provides this automatically) ----
DATABASE_URL=postgresql://user:password@host:5432/railway

# ---- OpenRouter (via ChatOpenAI / langchain-openai) ----
# Split by stakes: cheap/high-volume content generation on DeepSeek, the single
# screening decision call on Claude. Leave unset to use these defaults.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_CONTENT=deepseek/deepseek-v4-flash-0731
OPENROUTER_MODEL_SCREENING=anthropic/claude-sonnet-5
OPENROUTER_TIMEOUT_SECONDS=60
CONFIRMED_CASE_QUERY_LIMIT=25

# ---- WhatsApp — Meta (Facebook) Cloud API ----
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=novera_verify_change_me
META_APP_SECRET=
META_API_VERSION=v22.0
WHATSAPP_TO=

# ---- post-reading wellness check-in delay (seconds) — how long after a
# reading lands before a separate "how are you feeling" WhatsApp message goes
# out. Screening itself still runs immediately, unaffected. Set to 0 to send
# the check-in right away too.
READING_FOLLOWUP_DELAY_SECONDS=600

# ---- admin/demo account (Hassan's own testing account) ----
# ADMIN_EMAIL: a real account (create it once with
# scripts/create_admin_account.py) that always has at least one biomarker
# reading on file, so dashboard/reports/self-care/voice/screening/WhatsApp
# all work for demos even with no sensor connected and no real test taken.
# Leave unset to fully disable — every account behaves exactly as before.
ADMIN_EMAIL=

# ADMIN_WA_TRIGGER_PHRASE: a shared-secret phrase — sending this as the
# ENTIRE text of a WhatsApp message, from ANY phone number, resolves that
# conversation to ADMIN_EMAIL's account for 24h (no phone pre-registration
# needed). This is a real bearer-secret backdoor, by deliberate design (so
# it works from any device for demos) — treat it exactly like a password:
# pick something non-guessable, never commit it, never share it beyond who
# needs it. Leave unset to disable the WhatsApp side of this feature (the
# website login still works normally either way).
ADMIN_WA_TRIGGER_PHRASE=

# ---- CORS (comma-separated; defaults already cover echo-nova.online + local dev +
# the Capacitor Android app's https://localhost origin) ----
CORS_ORIGINS=https://www.echo-nova.online,https://echo-nova.online,http://localhost:5173,http://127.0.0.1:5173,https://localhost

# ---- public URLs (used to build the Thawani payment-callback redirect target) ----
PUBLIC_SITE_URL=https://www.echo-nova.online
PUBLIC_API_URL=https://api.echo-nova.online

# ---- Thawani (Oman payment gateway) — /buy device + strip-bundle checkout ----
# Leave both unset to keep checkout honestly disabled (503, nothing charged).
# THAWANI_ENV=development uses Thawani's UAT/sandbox API; set to "production"
# only once ready to take real payments.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_ENV=development

# ---- misc ----
PORT=8000
