# ---- database (Railway Postgres plugin provides this automatically) ----
DATABASE_URL=postgresql://user:password@host:5432/railway

# ---- OpenRouter (via ChatOpenAI / langchain-openai) ----
# Split by stakes: cheap/high-volume content generation on DeepSeek, the single
# screening decision call on Claude. Leave unset to use these defaults.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_CONTENT=deepseek/deepseek-chat-v3.1
OPENROUTER_MODEL_SCREENING=anthropic/claude-sonnet-5
OPENROUTER_TIMEOUT_SECONDS=60
CONFIRMED_CASE_QUERY_LIMIT=25

# ---- WhatsApp — Meta (Facebook) Cloud API ----
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=novera_verify_change_me
META_APP_SECRET=
META_API_VERSION=v22.0
WHATSAPP_TO=

# ---- CORS (comma-separated; defaults already cover echo-nova.online + local dev +
# the Capacitor Android app's https://localhost origin) ----
CORS_ORIGINS=https://www.echo-nova.online,https://echo-nova.online,http://localhost:5173,http://127.0.0.1:5173,https://localhost

# ---- misc ----
PORT=8000
