# ---- database (Railway Postgres plugin provides this automatically) ----
DATABASE_URL=postgresql://user:password@host:5432/railway

# ---- OpenRouter (via ChatOpenAI / langchain-openai) ----
# Split by stakes: cheap/high-volume content generation on DeepSeek, the single
# screening decision call on Claude. Leave unset to use these defaults.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL_CONTENT=deepseek/deepseek-v4-flash-0731
OPENROUTER_MODEL_SCREENING=anthropic/claude-sonnet-5
OPENROUTER_TIMEOUT_SECONDS=60
CONFIRMED_CASE_QUERY_LIMIT=25

# ---- WhatsApp — Meta (Facebook) Cloud API ----
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=novera_verify_change_me
META_APP_SECRET=
META_API_VERSION=v22.0
WHATSAPP_TO=

# ---- WhatsApp follow-up delay (seconds) — how long after a sensor reading
# lands before the WhatsApp Agent's screening + any message actually fires.
# Default 600 (10 min), so a proactive message reads as a genuine follow-up,
# not an instant auto-reply. Set to 0 to go back to immediate.
READING_FOLLOWUP_DELAY_SECONDS=600

# ---- CORS (comma-separated; defaults already cover echo-nova.online + local dev +
# the Capacitor Android app's https://localhost origin) ----
CORS_ORIGINS=https://www.echo-nova.online,https://echo-nova.online,http://localhost:5173,http://127.0.0.1:5173,https://localhost

# ---- public URLs (used to build the Thawani payment-callback redirect target) ----
PUBLIC_SITE_URL=https://www.echo-nova.online
PUBLIC_API_URL=https://api.echo-nova.online

# ---- Thawani (Oman payment gateway) — /buy device + strip-bundle checkout ----
# Leave both unset to keep checkout honestly disabled (503, nothing charged).
# THAWANI_ENV=development uses Thawani's UAT/sandbox API; set to "production"
# only once ready to take real payments.
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_ENV=development

# ---- misc ----
PORT=8000
